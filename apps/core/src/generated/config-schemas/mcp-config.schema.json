{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "configVersion": {
      "type": "number",
      "const": 1,
      "description": "Configuration format version.",
      "markdownDescription": "Configuration format version."
    },
    "servers": {
      "description": "MCP servers keyed by server ID. Reload MCP after saving to apply changes.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "const": "stdio",
                "description": "`stdio` starts a local process; `http` connects to a URL.",
                "markdownDescription": "`stdio` starts a local process; `http` connects to a URL."
              },
              "allowSubagents": {
                "default": false,
                "description": "Expose this server's tools to subagents whose profile allows the plugin.",
                "type": "boolean",
                "markdownDescription": "Expose this server's tools to subagents whose profile allows the plugin."
              },
              "description": {
                "description": "Shown to the agent before the server's own description.",
                "type": "string",
                "minLength": 1,
                "x-lilac": { "kind": "multiline" },
                "markdownDescription": "Shown to the agent before the server's own description."
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "Executable to start, such as `npx` or `uvx`.",
                "markdownDescription": "Executable to start, such as `npx` or `uvx`."
              },
              "args": {
                "description": "Command arguments.",
                "type": "array",
                "items": { "type": "string" },
                "markdownDescription": "Command arguments."
              },
              "cwd": {
                "description": "Working directory for the process.",
                "type": "string",
                "minLength": 1,
                "markdownDescription": "Working directory for the process."
              },
              "env": {
                "description": "Environment variables for the process.",
                "type": "object",
                "propertyNames": { "type": "string", "minLength": 1 },
                "additionalProperties": {
                  "anyOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "env": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Environment variable that holds the value.",
                          "markdownDescription": "Environment variable that holds the value."
                        },
                        "prefix": {
                          "description": "Text prepended to the value, such as `Bearer `.",
                          "type": "string",
                          "markdownDescription": "Text prepended to the value, such as `Bearer `."
                        }
                      },
                      "required": ["env"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "file": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Path of a file that holds the value.",
                          "markdownDescription": "Path of a file that holds the value."
                        },
                        "pointer": {
                          "description": "JSON Pointer into the file when it is JSON, such as `/token`.",
                          "type": "string",
                          "markdownDescription": "JSON Pointer into the file when it is JSON, such as `/token`."
                        },
                        "prefix": {
                          "description": "Text prepended to the value, such as `Bearer `.",
                          "type": "string",
                          "markdownDescription": "Text prepended to the value, such as `Bearer `."
                        }
                      },
                      "required": ["file"],
                      "additionalProperties": false
                    }
                  ],
                  "x-lilac": { "kind": "valueSource" }
                },
                "markdownDescription": "Environment variables for the process."
              }
            },
            "required": ["transport", "command"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "const": "http",
                "description": "`stdio` starts a local process; `http` connects to a URL.",
                "markdownDescription": "`stdio` starts a local process; `http` connects to a URL."
              },
              "allowSubagents": {
                "default": false,
                "description": "Expose this server's tools to subagents whose profile allows the plugin.",
                "type": "boolean",
                "markdownDescription": "Expose this server's tools to subagents whose profile allows the plugin."
              },
              "description": {
                "description": "Shown to the agent before the server's own description.",
                "type": "string",
                "minLength": 1,
                "x-lilac": { "kind": "multiline" },
                "markdownDescription": "Shown to the agent before the server's own description."
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "Streamable HTTP endpoint, such as `https://example.com/mcp`.",
                "markdownDescription": "Streamable HTTP endpoint, such as `https://example.com/mcp`."
              },
              "headers": {
                "description": "HTTP headers sent with every request.",
                "type": "object",
                "propertyNames": { "type": "string", "minLength": 1 },
                "additionalProperties": {
                  "anyOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "properties": {
                        "env": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Environment variable that holds the value.",
                          "markdownDescription": "Environment variable that holds the value."
                        },
                        "prefix": {
                          "description": "Text prepended to the value, such as `Bearer `.",
                          "type": "string",
                          "markdownDescription": "Text prepended to the value, such as `Bearer `."
                        }
                      },
                      "required": ["env"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "file": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Path of a file that holds the value.",
                          "markdownDescription": "Path of a file that holds the value."
                        },
                        "pointer": {
                          "description": "JSON Pointer into the file when it is JSON, such as `/token`.",
                          "type": "string",
                          "markdownDescription": "JSON Pointer into the file when it is JSON, such as `/token`."
                        },
                        "prefix": {
                          "description": "Text prepended to the value, such as `Bearer `.",
                          "type": "string",
                          "markdownDescription": "Text prepended to the value, such as `Bearer `."
                        }
                      },
                      "required": ["file"],
                      "additionalProperties": false
                    }
                  ],
                  "x-lilac": { "kind": "valueSource" }
                },
                "markdownDescription": "HTTP headers sent with every request."
              },
              "auth": {
                "description": "OAuth authorization for the server.",
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "oauth" },
                  "grant": { "type": "string", "const": "authorization_code" },
                  "scopes": {
                    "description": "OAuth scopes to request.",
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "markdownDescription": "OAuth scopes to request."
                  },
                  "client": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": { "type": "string", "const": "static" },
                          "clientId": {
                            "anyOf": [
                              { "type": "string" },
                              {
                                "type": "object",
                                "properties": {
                                  "env": {
                                    "type": "string",
                                    "minLength": 1,
                                    "description": "Environment variable that holds the value.",
                                    "markdownDescription": "Environment variable that holds the value."
                                  },
                                  "prefix": {
                                    "description": "Text prepended to the value, such as `Bearer `.",
                                    "type": "string",
                                    "markdownDescription": "Text prepended to the value, such as `Bearer `."
                                  }
                                },
                                "required": ["env"],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "file": {
                                    "type": "string",
                                    "minLength": 1,
                                    "description": "Path of a file that holds the value.",
                                    "markdownDescription": "Path of a file that holds the value."
                                  },
                                  "pointer": {
                                    "description": "JSON Pointer into the file when it is JSON, such as `/token`.",
                                    "type": "string",
                                    "markdownDescription": "JSON Pointer into the file when it is JSON, such as `/token`."
                                  },
                                  "prefix": {
                                    "description": "Text prepended to the value, such as `Bearer `.",
                                    "type": "string",
                                    "markdownDescription": "Text prepended to the value, such as `Bearer `."
                                  }
                                },
                                "required": ["file"],
                                "additionalProperties": false
                              }
                            ],
                            "x-lilac": { "kind": "valueSource" },
                            "description": "OAuth client ID.",
                            "markdownDescription": "OAuth client ID."
                          },
                          "clientSecret": {
                            "description": "OAuth client secret.",
                            "anyOf": [
                              { "type": "string" },
                              {
                                "type": "object",
                                "properties": {
                                  "env": {
                                    "type": "string",
                                    "minLength": 1,
                                    "description": "Environment variable that holds the value.",
                                    "markdownDescription": "Environment variable that holds the value."
                                  },
                                  "prefix": {
                                    "description": "Text prepended to the value, such as `Bearer `.",
                                    "type": "string",
                                    "markdownDescription": "Text prepended to the value, such as `Bearer `."
                                  }
                                },
                                "required": ["env"],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "file": {
                                    "type": "string",
                                    "minLength": 1,
                                    "description": "Path of a file that holds the value.",
                                    "markdownDescription": "Path of a file that holds the value."
                                  },
                                  "pointer": {
                                    "description": "JSON Pointer into the file when it is JSON, such as `/token`.",
                                    "type": "string",
                                    "markdownDescription": "JSON Pointer into the file when it is JSON, such as `/token`."
                                  },
                                  "prefix": {
                                    "description": "Text prepended to the value, such as `Bearer `.",
                                    "type": "string",
                                    "markdownDescription": "Text prepended to the value, such as `Bearer `."
                                  }
                                },
                                "required": ["file"],
                                "additionalProperties": false
                              }
                            ],
                            "x-lilac": { "kind": "valueSource" },
                            "markdownDescription": "OAuth client secret."
                          }
                        },
                        "required": ["type", "clientId"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": { "type": { "type": "string", "const": "dynamic" } },
                        "required": ["type"],
                        "additionalProperties": false
                      }
                    ],
                    "description": "`dynamic` registers a client with the server. `static` uses a client ID and optional secret.",
                    "markdownDescription": "`dynamic` registers a client with the server. `static` uses a client ID and optional secret."
                  }
                },
                "required": ["type", "grant", "client"],
                "additionalProperties": false,
                "markdownDescription": "OAuth authorization for the server."
              }
            },
            "required": ["transport", "url"],
            "additionalProperties": false
          }
        ]
      },
      "markdownDescription": "MCP servers keyed by server ID. Reload MCP after saving to apply changes."
    }
  },
  "required": ["configVersion"],
  "additionalProperties": false,
  "title": "Lilac MCP configuration"
}
