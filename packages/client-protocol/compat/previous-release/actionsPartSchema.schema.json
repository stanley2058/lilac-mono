{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": { "type": "string", "const": "data-actions" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "data": {
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "actions": {
          "maxItems": 25,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actionId": { "type": "string", "minLength": 1, "maxLength": 512 },
              "label": { "type": "string", "minLength": 1, "maxLength": 256 },
              "style": { "type": "string", "enum": ["primary", "secondary", "danger", "success"] },
              "disabled": { "type": "boolean" }
            },
            "required": ["actionId", "label", "style"],
            "additionalProperties": false
          }
        }
      },
      "required": ["requestId", "revision", "actions"],
      "additionalProperties": false
    }
  },
  "required": ["type", "id", "data"],
  "additionalProperties": false
}
