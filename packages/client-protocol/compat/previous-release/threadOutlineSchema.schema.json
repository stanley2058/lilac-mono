{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "historyGeneration": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positions": {
      "maxItems": 256,
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
    },
    "windows": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "firstPosition": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "endPosition": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "startAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "endAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "continues": { "type": "boolean", "const": true }
        },
        "required": ["firstPosition", "endPosition", "startAt", "endAt"],
        "additionalProperties": false
      }
    },
    "earlierBefore": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  },
  "required": ["historyGeneration", "positions"],
  "additionalProperties": false
}
