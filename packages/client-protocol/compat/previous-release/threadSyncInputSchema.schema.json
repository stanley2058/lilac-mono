{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "protocolVersion": { "type": "number", "const": 1 },
        "historyGeneration": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "projectionRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": ["protocolVersion", "historyGeneration", "projectionRevision", "cursor"],
      "additionalProperties": false
    }
  },
  "required": ["threadId"],
  "additionalProperties": false
}
