{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "historyGeneration": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "projectionRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "slotId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "aroundPosition": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  },
  "required": ["threadId", "historyGeneration", "projectionRevision", "slotId"],
  "additionalProperties": false
}
