{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "blocked",
        "waiting",
        "waiting-reply",
        "paused",
        "needs-attention",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "startedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "endedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "progress": {
      "type": "object",
      "properties": {
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "queued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "active": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "waiting": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["completed", "queued", "active", "waiting", "failed", "cancelled", "total"],
      "additionalProperties": false
    },
    "phases": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "completed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "queued": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "active": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "waiting": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cancelled": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "completed",
          "queued",
          "active",
          "waiting",
          "failed",
          "cancelled",
          "total"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 512
          },
          "kind": {
            "type": "string",
            "enum": ["agent", "wait"]
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "dispatched",
              "running",
              "blocked",
              "succeeded",
              "failed",
              "cancelled",
              "timed_out"
            ]
          }
        },
        "required": ["kind", "state"],
        "additionalProperties": false
      }
    },
    "wait": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["reply", "sleep"]
        },
        "prompt": {
          "type": "string",
          "maxLength": 512
        },
        "dueAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadlineAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "replyToMessage": {
          "type": "boolean"
        },
        "elsewhere": {
          "type": "boolean"
        }
      },
      "required": ["kind", "prompt", "replyToMessage", "elsewhere"],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["text", "json"]
            },
            "text": {
              "type": "string",
              "maxLength": 16384
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": ["kind", "text", "truncated"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "stored"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        }
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 4096
    },
    "agents": {
      "type": "object",
      "properties": {
        "used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "active": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "queued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["used", "active", "queued"],
      "additionalProperties": false
    },
    "nextRunAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sensitive": {
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "description",
    "status",
    "startedAt",
    "progress",
    "phases",
    "steps",
    "agents",
    "sensitive"
  ],
  "additionalProperties": false
}
