{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ordinal": { "type": "integer", "minimum": 1, "maximum": 3 },
    "total": { "type": "integer", "minimum": 1, "maximum": 3 },
    "header": { "type": "string", "minLength": 1, "maxLength": 80 },
    "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "options": {
      "minItems": 2,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": { "type": "integer", "minimum": 1, "maximum": 3 },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "token": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "required": ["index", "label", "description", "token"],
        "additionalProperties": false
      }
    },
    "customToken": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "required": ["ordinal", "total", "header", "question", "options", "customToken"],
  "additionalProperties": false
}
