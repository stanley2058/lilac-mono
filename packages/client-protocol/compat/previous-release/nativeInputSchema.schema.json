{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "historyGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "questionReply": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["messageId", "token"],
      "additionalProperties": false
    },
    "text": {
      "type": "string",
      "maxLength": 65536
    },
    "mode": {
      "type": "string",
      "enum": ["prompt", "steer", "followup"]
    },
    "attachmentIds": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "skillIds": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "reasoning": {
      "type": "string",
      "enum": ["provider-default", "none", "minimal", "low", "medium", "high", "xhigh", "max"]
    },
    "command": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "arguments": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": ["id", "arguments"],
      "additionalProperties": false
    }
  },
  "required": [
    "threadId",
    "commandId",
    "historyGeneration",
    "text",
    "mode",
    "attachmentIds",
    "skillIds"
  ],
  "additionalProperties": false
}
