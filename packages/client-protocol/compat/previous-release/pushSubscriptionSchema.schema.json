{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    },
    "keys": {
      "type": "object",
      "properties": {
        "p256dh": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{87}$"
        },
        "auth": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        }
      },
      "required": ["p256dh", "auth"],
      "additionalProperties": false
    },
    "completion": {
      "type": "boolean"
    },
    "failure": {
      "type": "boolean"
    }
  },
  "required": ["endpoint", "keys", "completion", "failure"],
  "additionalProperties": false
}
