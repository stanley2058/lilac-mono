{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "end": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "prefix": {
      "type": "string",
      "maxLength": 32
    },
    "suffix": {
      "type": "string",
      "maxLength": 32
    },
    "comment": {
      "type": "string",
      "maxLength": 8000
    }
  },
  "required": ["version", "threadId", "messageId", "text", "start", "end", "prefix", "suffix"],
  "additionalProperties": false
}
