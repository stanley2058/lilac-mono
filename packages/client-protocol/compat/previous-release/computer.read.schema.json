{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "desktop": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "generation": { "type": "string", "minLength": 1, "maxLength": 128 },
            "url": {
              "anyOf": [
                { "type": "string", "maxLength": 8192, "format": "uri" },
                { "type": "string", "maxLength": 8192, "pattern": "^\\/computer\\.html\\?.*" }
              ]
            },
            "password": { "type": "string", "minLength": 1, "maxLength": 256 },
            "expiresAt": { "type": "string", "maxLength": 64 }
          },
          "required": ["generation", "url", "password", "expiresAt"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    }
  },
  "required": ["desktop"],
  "additionalProperties": false
}
