{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "historyGeneration": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "previews": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "position": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "user": { "type": "string", "maxLength": 160 },
          "reply": { "type": "string", "maxLength": 280 }
        },
        "required": ["position"],
        "additionalProperties": false
      }
    }
  },
  "required": ["historyGeneration", "previews"],
  "additionalProperties": false
}
