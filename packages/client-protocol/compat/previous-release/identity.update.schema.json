{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "discordUserId": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$"
    },
    "id": {
      "type": "string",
      "const": "lilac"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "avatarUrl": {
      "type": "string",
      "maxLength": 512
    }
  },
  "required": ["id", "displayName"],
  "additionalProperties": false
}
